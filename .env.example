# Local development only. The database port is bound to loopback.
NOVA_DATABASE_URL=postgresql://nova:nova-local@127.0.0.1:55432/nova_ember
NOVA_TEST_DATABASE_URL=postgresql://nova:nova-local@127.0.0.1:55432/nova_ember_test
# OpenAI is configured securely for the backend; hosting follows final local testing.
# Store the real key only in the confirmed, ignored .env.local file.
NOVA_DAILY_MODEL_BUDGET_USD=5
NOVA_REQUEST_MODEL_BUDGET_USD=0.10
